# SkyLite-UX Environment Configuration
# Copy this file to .env and configure your settings

# ===========================================
# DATABASE (Required)
# ===========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skylite?schema=public"

# ===========================================
# API KEY ENCRYPTION (Required)
# ===========================================
# Google Calendar is configured in Settings > Integrations with your own
# Google OAuth client ID and secret; no environment variables are needed.

# Generate with: openssl rand -hex 32
# Output will be 64 hex characters (e.g., a1b2c3d4e5f6...)
# This key encrypts third-party API keys (Immich, Mealie, Tandoor, ...) at rest.
# Keep it secret — losing it means re-entering those API keys.
NUXT_OAUTH_ENCRYPTION_KEY=""

# ===========================================
# APPLICATION SETTINGS (Optional)
# ===========================================

# Timezone for date/time display (IANA format)
# Default: America/Chicago
NUXT_PUBLIC_TZ="America/Chicago"

# Log level: trace, debug, info, warn, error
# Default: info
NUXT_PUBLIC_LOG_LEVEL="info"

# ===========================================
# HOME ASSISTANT & WEATHER (Configured via UI)
# ===========================================
# Note: Home Assistant URL/token and OpenWeatherMap API key
# are configured through the Settings UI, not environment variables.
# They are stored in the database via the integration system.
